# Frontend Supabase config
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Required only when POSTGRES import should prune stale pipeline-export objects
# from Supabase Storage immediately after promotion.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
NEXT_PUBLIC_CITIZEN_PHOTO_BUCKET="citizen-photos"

# R pipeline / PostgreSQL import
# Use the Session pooler URI from Supabase Dashboard -> Connect -> Session pooler.
# Region must match your project (e.g. aws-0-eu-north-1, not eu-central-1).
# User is postgres.<project-ref>, not postgres, when connecting via pooler.
DATABASE_URL="postgresql://postgres.your-project:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require"

# Database-backed steps.
# SUPABASE_OBSERVATIONS_ENABLED MUST be "1" for scheduled/production pipeline
# runs so approved structured surveys are pulled into the run. If it is left
# unset/"0", NO citizen-submitted data ever reaches live scores (the R code
# default when unset is "0", so this has to be set deliberately). Set to "0"
# only for local dry-runs that just stage map tiles for manual upload.
SUPABASE_OBSERVATIONS_ENABLED="1"
# POSTGRES_IMPORT_ENABLED registers/promotes the active pipeline dataset in
# Postgres when the R export step runs. Heavy cell detail stays in Storage by
# default and is read by the frontend from PMTiles/cell-details shards.
POSTGRES_IMPORT_ENABLED="0"

# Optional legacy/full import. Set to "1" only when you need full
# cell_attributes/green_spaces rows in Postgres for PostGIS analysis.
POSTGRES_IMPORT_CELL_ATTRIBUTES="0"

# Optional strict mode. Use "1" only when the run must fail if the database
# export/import cannot complete.
SUPABASE_OBSERVATIONS_REQUIRED="0"
POSTGRES_IMPORT_REQUIRED="0"

# Optional per-city raster/API inputs. Not needed for a normal run.
# PLANET_API_KEY unlocks PlanetScope NDVI (00_download/download_planetscope_ndvi.R)
# and consumes your Education & Research quota.
PLANET_API_KEY=""
# TELRAAM_API_KEY is used ONCE, offline, to fit the traffic emission weights
# from citizen traffic counts in Gent (calibration/fit_emission_weights.R).
# The counts are never exported — only the fitted weights are committed — so a
# normal pipeline run does not need this key.
TELRAAM_API_KEY=""
